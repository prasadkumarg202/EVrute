# ---------------------------------------------------------------------------
# EVRute environment. Copy to apps/web/.env.local and fill in.
# Never commit a filled-in copy — .gitignore already excludes .env*
# ---------------------------------------------------------------------------

# Supabase (project: evrute, ap-south-1)
NEXT_PUBLIC_SUPABASE_URL=https://lijppnmtnnrxczkuhqlh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_tKHBU6Zosw3el0rxZAMEOA_WW9l2EH3
# Service role: bypasses RLS. Server-only. Get it from
# Supabase dashboard -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Charging provider: simulator | chargelab | edrv
CHARGING_PROVIDER=simulator
CHARGING_PROVIDER_BASE_URL=
CHARGING_PROVIDER_API_KEY=
CHARGING_PROVIDER_WEBHOOK_SECRET=

# Payments
PAYMENT_PROVIDER=razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shared secret for /api/cron/* routes (settlements, rollups, expiry)
CRON_SECRET=

# Statutory rates applied by the settlement engine
PLATFORM_GST_PCT=18
PLATFORM_TDS_PCT=1
